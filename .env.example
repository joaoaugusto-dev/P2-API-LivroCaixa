# Copie para .env (que fica fora do git) e preencha.

# Banco PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# --- Backend Node ---
PORT=3333
# Endereço do front-end liberado no CORS (vários separados por vírgula)
CORS_ORIGENS=http://localhost:5173
# Segredo do JWT, mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=
JWT_EXPIRA_EM=15m
REFRESH_EXPIRA_DIAS=7
# Senha dos usuários criados por "npm run db:seed" (só desenvolvimento, mínimo 8 caracteres)
SEED_SENHA=
